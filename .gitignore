*.swp
*.swo
.DS_Store

# Terraform specific
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraformrc
terraform.rc
.terraform.lock.hcl

# Environment variables
.env
.env.* 

# terraform state file store
terraform-configs/*/state

